# =================================================================
# Root Environment Variables (Unified Orchestration & Cloud Setup)
# =================================================================

# Global Environment
APP_ENV=production

# PostgreSQL Database (Book Catalog Service)
POSTGRES_DB=library_books_db
POSTGRES_USER=libuser
POSTGRES_PASSWORD=libpass_secure_123
POSTGRES_PORT=5432

# MySQL Database (Member & Borrowing Service)
MYSQL_DATABASE=library_members_db
MYSQL_USER=libmemberuser
MYSQL_PASSWORD=memberpass_secure_123
MYSQL_ROOT_PASSWORD=rootpass_secure_123
MYSQL_PORT=3306

# Microservice Ports
GATEWAY_PORT=8080
BOOK_SERVICE_PORT=8001
MEMBER_SERVICE_PORT=8002
FRONTEND_PORT=3000

# Inter-Service Communication Target URLs (For Multi-VM Deployment, replace with VM Public/Private IPs)
BOOK_SERVICE_URL=http://book-service:8001
MEMBER_SERVICE_URL=http://member-borrow-service:8002
